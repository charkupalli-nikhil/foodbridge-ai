MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=foodbridge_ai
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Feature 1: Photo Originality & Anti-Fraud
ALLOW_GALLERY_UPLOAD=false
ALLOWED_PHOTO_AGE_MINUTES=30
ALLOWED_CAPTURE_DISTANCE_KM=1.0
DUPLICATE_HAMMING_THRESHOLD=6
ENABLE_REVERSE_IMAGE_SEARCH=false
GOOGLE_APPLICATION_CREDENTIALS=

# Feature 2: Geocoding & Distance Matching
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=FoodBridgeAI/1.0
ROUTING_PROVIDER=haversine_estimate
ROUTING_API_KEY=
MATCH_RADIUS_KM=25
NOTIFY_RADIUS_KM=0
AVERAGE_URBAN_SPEED_KMH=25